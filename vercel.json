{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "index.html",
          "projects.html",
          "privacy.html",
          "manifest.json",
          "robots.txt",
          "sitemap.xml",
          "knowledge.json",
          "data/**",
          "database/**",
          "css/**",
          "js/**",
          "assets/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
